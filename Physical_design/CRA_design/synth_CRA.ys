read_verilog ../../RTL_verilog/Carry_Ripple_Adder/carry_ripple_adder.v 
read_verilog ../../RTL_verilog/Carry_Ripple_Adder/full_adder.v

hierarchy -check -top carry_ripple_adder

#proc; opt; fsm; opt; memory; opt
synth -top carry_ripple_adder

techmap; opt

# mapping flip-flops to path were .lib is located
dfflibmap -liberty /home/iago/Documentos/HDL/libs_cells/NanGate_45nm_OCL_v2010_12/NanGate_45nm_OCL_v2010_12/pdk_v1.3_v2010_12/NangateOpenCellLibrary_PDKv1_3_v2010_12/NangateOpenCellLibrary_PDKv1_3_v2010_12/Front_End/Liberty/NangateOpenCellLibrary_functional.lib

# mapping logic to path were .lib is located
abc -liberty /home/iago/Documentos/HDL/libs_cells/NanGate_45nm_OCL_v2010_12/NanGate_45nm_OCL_v2010_12/pdk_v1.3_v2010_12/NangateOpenCellLibrary_PDKv1_3_v2010_12/NangateOpenCellLibrary_PDKv1_3_v2010_12/Front_End/Liberty/NangateOpenCellLibrary_functional.lib

# cleanup
clean

#
stat -liberty /home/iago/Documentos/HDL/libs_cells/NanGate_45nm_OCL_v2010_12/NanGate_45nm_OCL_v2010_12/pdk_v1.3_v2010_12/NangateOpenCellLibrary_PDKv1_3_v2010_12/NangateOpenCellLibrary_PDKv1_3_v2010_12/Front_End/Liberty/NangateOpenCellLibrary_functional.lib

# write synthesized design
write_verilog carry_ripple_adder_synth_45nm.v

